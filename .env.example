# Environment secrets & private endpoints for AI tooling (sourced by zsh/ai.zsh).
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# .env is gitignored and never committed.

# Private AI gateway base URL (used by claude/aider/codex aliases).
export ANTHROPIC_BASE_URL=""

export GOCODE_API_TOKEN=""
export OPENAI_API_KEY=$GOCODE_API_TOKEN
