[user]
	email = redacted@example.com
	name = Jono Gould

[includeIf "gitdir:~/GD_Dev/**/.git"]
	path = ~/.gitconfig.work

; [includeIf "gitdir:~/Developer/**/.git"]
; 	path = ~/.gitconfig.home

; [url "git@github.com:"]
; 	insteadOf = https://github.com/ 

[alias]
	st = status
	co = checkout
	unstage = reset HEAD
	hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short

	diffh = "!f() { git diff \"$@\" | ~/.dotfiles/git/contrib/diff-highlight; }; f"

	# Fancy logging.
	#   h = head
	#   hp = head with patch
	#   r = recent commits, only current branch
	#   ra = recent commits, all reachable refs
	#   l = all commits, only current branch
	#   la = all commits, all reachable refs
	head = !git l -1
	h = !git head
	r = !git l -30
	ra = !git r --all
	l = "!source ~/.dotfiles/git/bin/githelpers && pretty_git_log"
	la = !git l --all

[difftool]
[diff]
[color]
	diff = auto
	status = auto
	branch = auto
	interactive = auto
	ui = auto
[color "branch"]
	current = green bold
	local = green
	remote = red bold
[color "diff"]
	meta = yellow
	frag = magenta
	old = red
	new = green
[color "status"]
	added = green bold
	changed = yellow bold
	untracked = red
[color "sh"]
	branch = yellow
[difftool]
	prompt = false
[diff]
	tool = gitk
[core]
	excludesfile = ~/.dotfiles/git/gitignore
[credential]
	helper = osxkeychain
[push]
	default = simple
[filter "media"]
	clean = git-media-clean %f
	smudge = git-media-smudge %f
[http]
	cookiefile = ***REMOVED***
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[pull]
	ff = only
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
