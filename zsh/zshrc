# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Path to your oh-my-zsh configuration.
ZSH=$HOME/.oh-my-zsh
ZSH_CUSTOM=$HOME/.dotfiles/zsh

export DISABLE_AUTO_UPDATE="true"
export DISABLE_AUTO_TITLE="true"
export EDITOR=nano

# Custom Stuff
export DOTFILES=$HOME/.dotfiles
export CODE=~$HOME/Developer
export TOOLS=$HOME/.tools
export NODE_PATH="/usr/local/lib/node_modules"
export NVM_DIR=~/.nvm

# gcloud
source /Users/jono/.tools/google-cloud-sdk/completion.zsh.inc
source /Users/jono/.tools/google-cloud-sdk/path.zsh.inc

# Plugins ~/.oh-my-zsh/plugins/*
plugins=(git npm z)

# Theme ~/.oh-my-zsh/themes/
#  ZSH_THEME="my-theme/my-theme"
 ZSH_THEME="powerlevel10k/powerlevel10k"

# oh-my-zsh
source $ZSH/oh-my-zsh.sh

# homebrew
path+=('/usr/local/bin:/usr/local/sbin')
path+=('/opt/homebrew/bin')

# git
path+=($DOTFILES/git/bin)

# tools
path+=($TOOLS)

# nvm
source $(brew --prefix nvm)/nvm.sh

# go
export GO111MODULE=on
export GOPRIVATE=github.com/overhq/*,github.com/gdcorp-im/*,github.com/gdcorp-golang/*
export GOPATH=$HOME/go
export GOROOT="$(brew --prefix golang)/libexec"
export PATH=$PATH:$GOPATH/bin
export MYSQL_ENV_MYSQL_ROOT_USERNAME=root
export MYSQL_ENV_MYSQL_ROOT_PASSWORD=root

# Import alias
source $DOTFILES/zsh/alias.zsh
source $DOTFILES/zsh/functions/*

export PATH # Add RVM to PATH for scripting

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
