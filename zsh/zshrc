# Path to your oh-my-zsh configuration.
ZSH=$HOME/.oh-my-zsh
ZSH_CUSTOM=$HOME/.dotfiles/zsh
export DISABLE_AUTO_UPDATE="true"
export DISABLE_AUTO_TITLE="true"
export EDITOR=vim

# rubby
export RBENV_ROOT=/usr/local/var/rbenv
if which rbenv > /dev/null; then eval "$(rbenv init -)"; fi

# Custom Stuff
export DOTFILES=$HOME/.dotfiles
export PROJECTS=~/Sites
export TOOLS=~/.tools

# Autoload Functions
fpath=($DOTFILES/zsh/functions $fpath)
autoload -U $DOTFILES/zsh/functions/*(:t)

# Plugins ~/.oh-my-zsh/plugins/*
plugins=(git brew vagrant sublime)

# Theme ~/.oh-my-zsh/themes/
 ZSH_THEME="my-theme"
# ZSH_THEME="miloshadzic"
# . $DOTFILES/zsh/prompt.zsh

# https://github.com/rupa/z
. $DOTFILES/zsh/plugins/z.sh

function precmd () {
    _z --add "$(pwd -P)"
}

# oh-my-zsh
source $ZSH/oh-my-zsh.sh

# NODE Exports
export NODE_PATH="/usr/local/lib/node_modules"

# Homebrew binaries
PATH=/usr/local/bin:/usr/local/sbin:$PATH
PATH="$(brew --prefix josegonzalez/php/php55)/bin:$PATH"
PATH=$PATH:/opt/homebrew/bin

# git workflow scripts
PATH=$PATH:$DOTFILES/git/bin

# tools
# PATH=$PATH:$TOOLS/minify

# Import aliases
source $DOTFILES/zsh/aliases.zsh

# initialize autocomplete here, otherwise functions won't be loaded
autoload -U compinit
compinit

unset MAILCHECK