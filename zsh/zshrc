# Path to your oh-my-zsh configuration.
ZSH=$HOME/.oh-my-zsh
ZSH_CUSTOM=$HOME/.dotfiles/zsh
export DISABLE_AUTO_UPDATE="true"
export DISABLE_AUTO_TITLE="true"
export EDITOR=nano

# gcloud
source /Users/jono/.tools/google-cloud-sdk/completion.zsh.inc
source /Users/jono/.tools/google-cloud-sdk/path.zsh.inc

# ruby
export RBENV_ROOT=/usr/local/var/rbenv
if which rbenv > /dev/null; then eval "$(rbenv init -)"; fi

# Custom Stuff
export DOTFILES=$HOME/.dotfiles
export CODE=~/Code
export TOOLS=~/.tools
export NODE_PATH="/usr/local/lib/node_modules"

# Autoload Functions
fpath=($DOTFILES/zsh/functions $fpath)
autoload -U $DOTFILES/zsh/functions/*(:t)

# Plugins ~/.oh-my-zsh/plugins/*
plugins=(git vagrant sublime)

# Theme ~/.oh-my-zsh/themes/
 ZSH_THEME="my-theme"
# ZSH_THEME="miloshadzic"
# . $DOTFILES/zsh/prompt.zsh

# https://github.com/rupa/z
. $DOTFILES/zsh/plugins/z.sh

function precmd () {
    _z --add "$(pwd -P)"
}

# oh-my-zsh
source $ZSH/oh-my-zsh.sh

# rvm
PATH=$HOME/.rvm/bin:$PATH

# nodejs
PATH=$NODE_PATH:$PATH

# composer
PATH=~/.composer/vendor/bin:$PATH

# homebrew
PATH=/usr/local/bin:/usr/local/sbin:$PATH
PATH=/opt/homebrew/bin:$PATH

# git
PATH=$PATH:$DOTFILES/git/bin

# tools
PATH=$PATH:$TOOLS

# go
export GO111MODULE=on
export GOPRIVATE=github.com/overhq
export GOPATH=$HOME/go
export GOROOT="$(brew --prefix golang)/libexec"
export PATH=$PATH:$GOPATH/bin
export MYSQL_ENV_MYSQL_ROOT_USERNAME=root
export MYSQL_ENV_MYSQL_ROOT_PASSWORD=root
export PIP3_BIN=/Users/jono/Library/Python/3.7/bin
export PATH=$PATH:$PIP3_BIN

# Import aliases
source $DOTFILES/zsh/aliases.zsh

# initialize autocomplete here, otherwise functions won't be loaded
autoload -U compinit
compinit

unset MAILCHECK


export PATH # Add RVM to PATH for scripting
