# Performance: Skip expensive operations
skip_global_compinit=1

# Performance: Zsh options for faster startup
setopt no_beep                # No beeps
setopt auto_cd                # cd by typing directory name
setopt multios                # Multiple redirections
setopt prompt_subst           # Allow command substitution in prompt

# Terminal compat: if the current $TERM has no terminfo entry on this host
# (common over SSH into servers that lack newer entries like xterm-ghostty,
# xterm-kitty), the line editor can't emit cursor-movement caps and the prompt
# corrupts (doubled characters, broken redraw, backspace weirdness). Fall back
# to a universally-present entry. Best long-term fix is installing the real
# entry on the host: `infocmp -x $TERM | ssh host 'tic -x -'`.
# Also fall back when the entry exists but lacks kcbt — zsh-autocomplete aborts
# its entire bindkey setup on a missing $terminfo[kcbt] (seen with Ghostty).
if [[ -n "$TERM" && "$TERM" != "dumb" ]]; then
    if ! infocmp "$TERM" >/dev/null 2>&1 || ! infocmp -1 "$TERM" 2>/dev/null | grep -q 'kcbt='; then
        export TERM=xterm-256color
    fi
fi

# History configuration (optimized)
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt append_history         # Append, don't overwrite
setopt hist_ignore_dups       # Ignore duplicate commands
setopt hist_reduce_blanks     # Remove unnecessary blanks
setopt share_history          # Share history across sessions

# Editor
export EDITOR=nano

# Custom Stuff
export DOTFILES=$HOME/.dotfiles
export CODE=$HOME/Developer
export TOOLS=$HOME/.tools

# Homebrew - detect prefix dynamically across macOS (arm/intel) and Linuxbrew
# so shellenv sets up PATH/MANPATH/etc. without a hardcoded path.
for _brew_candidate in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    if [[ -x "$_brew_candidate" ]]; then
        eval "$("$_brew_candidate" shellenv)"
        break
    fi
done
unset _brew_candidate

# Deduplicate PATH automatically (makes PATH handling faster)
typeset -U path

# Consolidate all PATH additions in one place for performance
# (brew bin dirs are added above via shellenv and preserved through $path)
path=(
    $DOTFILES/git/bin
    $TOOLS
    $HOME/.antidote
    $HOME/go/bin
    $HOME/.local/bin
    $HOME/.lmstudio/bin
    # $HOME/.claude/local/claude/bin
    $HOME/.antigravity/antigravity/bin
    $path
)

# Import alias (with file check)
[[ -f $DOTFILES/zsh/alias.zsh ]] && source $DOTFILES/zsh/alias.zsh

# Load all custom functions (history.zsh is sourced separately after plugins)
# Skip *.zwc artifacts: sourcing a compiled file by its .zwc path parses the
# wordcode binary as text. The base .zsh names transparently use their .zwc.
for func_file in $DOTFILES/zsh/functions/*; do
    [[ -f "$func_file" && "${func_file:e}" != "zwc" && "${func_file:t}" != "history.zsh" ]] && source "$func_file"
done

# Load custom theme (with file check)
[[ -f $DOTFILES/zsh/themes/my-theme/my-theme.zsh-theme ]] && source $DOTFILES/zsh/themes/my-theme/my-theme.zsh-theme

# go - cached brew prefix for performance
export GO111MODULE=on
# GOPRIVATE (private org globs) is set in zsh/local.zsh (gitignored).
export GOPATH=$HOME/go
# Derive GOROOT from the installed go toolchain (portable across macOS/Linux)
if [[ -z "${GOROOT:-}" ]] && command -v go >/dev/null 2>&1; then
    export GOROOT="$(go env GOROOT)"
fi

# Turn it all OFF
DO_NOT_TRACK=1

# AI integration (lazy loaded - only sources when file exists)
[[ -f $DOTFILES/zsh/ai.zsh ]] && source $DOTFILES/zsh/ai.zsh

# Machine/employer-specific overrides (gitignored). Holds private aliases,
# internal paths, GOPRIVATE orgs, and internal tool shims. See local.zsh.example.
[[ -f $DOTFILES/zsh/local.zsh ]] && source $DOTFILES/zsh/local.zsh

# Antidote - use static loading for performance (faster than dynamic)
# The .zsh_plugins.zsh file is pre-generated and just sources plugins directly.
# Self-heal when the bundle is missing/empty, or when the antidote cache was
# cleared (e.g. macOS cache cleanup) and cloned plugin paths no longer exist.
_antidote_ensure_plugins() {
    [[ -f ~/.zsh_plugins.txt ]] || return
    local line path antidote_zsh candidate needs_rebuild=0

    if [[ ! -s ~/.zsh_plugins.zsh ]]; then
        needs_rebuild=1
    else
        for line in ${(f)"$(<~/.zsh_plugins.zsh)"}; do
            [[ "$line" == source\ * ]] && break
            line=""
        done
        if [[ -z "$line" ]]; then
            needs_rebuild=1
        else
            path="${line#source }"
            path="${path//\"/}"
            [[ -f "$path" ]] || needs_rebuild=1
        fi
    fi
    (( needs_rebuild )) || return

    for candidate in \
        "$(brew --prefix antidote 2>/dev/null)/share/antidote/antidote.zsh" \
        "$HOME/.antidote/antidote.zsh"; do
        [[ -f "$candidate" ]] && antidote_zsh="$candidate" && break
    done
    [[ -z "$antidote_zsh" ]] && return

    # Non-login shells may not have system paths yet; antidote needs git/awk/etc.
    path=(/usr/local/bin /usr/bin /bin /usr/sbin /sbin ${HOMEBREW_PREFIX:+$HOMEBREW_PREFIX/bin} $path)
    source "$antidote_zsh"
    antidote bundle <~/.zsh_plugins.txt >~/.zsh_plugins.zsh
    zcompile ~/.zsh_plugins.zsh 2>/dev/null
}
_antidote_ensure_plugins
unfunction _antidote_ensure_plugins

# zsh-autocomplete bindkeys menu-search/recent-paths before its precmd creates
# them. fast-syntax-highlighting then warns "unhandled ZLE widget". Stub first
# so FSH sees real user widgets; autocomplete's precmd replaces with zle -C.
.zsh-autocomplete-stub() { :; }
zle -N menu-search .zsh-autocomplete-stub
zle -N recent-paths .zsh-autocomplete-stub
zle -N insert-unambiguous-or-complete .zsh-autocomplete-stub

[[ -s ~/.zsh_plugins.zsh ]] && source ~/.zsh_plugins.zsh

# Completions: zsh-autocomplete (via antidote). list-colors only (visual).
zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS} "ma=1;30;48;5;73"

# ↑ = prefix history ("claude " → prior args). Autocomplete's up-line-or-search
# only matches the first word and feels broken for this. ↓ stays enter-completion-list.
bindkey '^[[A' history-beginning-search-backward
bindkey '^[OA' history-beginning-search-backward

# Safety net: if autocomplete's bindkey setup aborted (missing terminfo caps),
# re-apply ↓ / Tab so the completion list is still reachable.
if (( ${+widgets[down-line-or-select]} )) && [[ "$(bindkey '^[[B')" != *down-line-or-select* ]]; then
    bindkey '^[[B' down-line-or-select
    bindkey '^[OB' down-line-or-select
    bindkey '^I'   complete-word
fi


# NVM - lazy-load only `nvm` (not node/npm/npx).
# Node itself is Homebrew's /opt/homebrew/bin/{node,npm}. Stubbing those
# caused "maximum nested function level reached" when the wrapper re-entered
# itself before a real binary was on PATH. `nvm use` still prepends version
# bins when you need a non-system Node.
# Homebrew installs nvm.sh under its prefix (NOT in ~/.nvm); git-clone/Linux
# installs put it in $NVM_DIR. Keep NVM_DIR set either way — Homebrew's nvm
# still uses it as the data dir. Prefer the brew copy, fall back to $NVM_DIR.
export NVM_DIR="$HOME/.nvm"
nvm() {
    unset -f nvm
    local _nvm_prefix
    _nvm_prefix="$(brew --prefix nvm 2>/dev/null)"
    if [[ -n "$_nvm_prefix" && -s "$_nvm_prefix/nvm.sh" ]]; then
        # shellcheck disable=SC1091
        . "$_nvm_prefix/nvm.sh"
        [[ -s "$_nvm_prefix/etc/bash_completion.d/nvm" ]] && . "$_nvm_prefix/etc/bash_completion.d/nvm"
    elif [[ -s "$NVM_DIR/nvm.sh" ]]; then
        # shellcheck disable=SC1091
        . "$NVM_DIR/nvm.sh"
        [[ -s "$NVM_DIR/bash_completion" ]] && . "$NVM_DIR/bash_completion"
    else
        print -u2 "nvm: nvm.sh not found (brew nvm or \$NVM_DIR)"
        return 127
    fi
    nvm "$@"
}

# Added by Antigravity IDE
# Guarded so it no-ops on machines without the Antigravity IDE installed.
[[ -d "$HOME/.antigravity-ide/antigravity-ide/bin" ]] && export PATH="$HOME/.antigravity-ide/antigravity-ide/bin:$PATH"

# git-lfs (installed via brew/apt/dnf/pacman, but guarded individually so
# hooks calling `git-lfs` still resolve it even outside the brew shellenv path)
[[ -n "$HOMEBREW_PREFIX" && -x "$HOMEBREW_PREFIX/bin/git-lfs" ]] && export PATH="$HOMEBREW_PREFIX/bin:$PATH"

if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi

# iTerm2 shell integration (marks, jump-to-prompt, badges). Guarded to iTerm2
# only so it's a no-op in Ghostty (which injects its own integration via
# GHOSTTY_SHELL_FEATURES) or any other terminal.
[[ "$TERM_PROGRAM" == "iTerm.app" && -f "$HOME/.iterm2_shell_integration.zsh" ]] && source "$HOME/.iterm2_shell_integration.zsh"

# BEGIN gocode
export PATH="$HOME/.gocode/shims":$PATH
# END gocode
command -v rbenv >/dev/null 2>&1 && eval "$(rbenv init - zsh)"

# fzf — Ctrl-R fuzzy history, Ctrl-T files, Alt-C cd (Brewfile / apt/dnf/pacman).
# Reclaim Tab for zsh-autocomplete after fzf's completion widget binds it.
if command -v fzf >/dev/null 2>&1; then
    eval "$(fzf --zsh)"
    (( ${+widgets[complete-word]} )) && bindkey '^I' complete-word
fi

# Optional local tool shims (no-op when dirs are absent)
[[ -d "$HOME/.local/bin" ]] && path=("$HOME/.local/bin" $path)
[[ -d "$HOME/.codeaf/bin" ]] && path=("$HOME/.codeaf/bin" $path)
