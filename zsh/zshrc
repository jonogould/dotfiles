# Performance: Skip expensive operations
skip_global_compinit=1

# Performance: Zsh options for faster startup
setopt no_beep                # No beeps
setopt auto_cd                # cd by typing directory name
setopt multios                # Multiple redirections
setopt prompt_subst           # Allow command substitution in prompt

# Terminal compat: if the current $TERM has no terminfo entry on this host
# (common over SSH into servers that lack newer entries like xterm-ghostty,
# xterm-kitty), the line editor can't emit cursor-movement caps and the prompt
# corrupts (doubled characters, broken redraw, backspace weirdness). Fall back
# to a universally-present entry. Best long-term fix is installing the real
# entry on the host: `infocmp -x $TERM | ssh host 'tic -x -'`.
if [[ -n "$TERM" && "$TERM" != "dumb" ]] && ! infocmp "$TERM" >/dev/null 2>&1; then
    export TERM=xterm-256color
fi

# History configuration (optimized)
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt append_history         # Append, don't overwrite
setopt hist_ignore_dups       # Ignore duplicate commands
setopt hist_reduce_blanks     # Remove unnecessary blanks
setopt share_history          # Share history across sessions

# Editor
export EDITOR=nano

# Custom Stuff
export DOTFILES=$HOME/.dotfiles
export CODE=$HOME/Developer
export TOOLS=$HOME/.tools
export NODE_PATH="/usr/local/lib/node_modules"

# Homebrew - detect prefix dynamically across macOS (arm/intel) and Linuxbrew
# so shellenv sets up PATH/MANPATH/etc. without a hardcoded path.
for _brew_candidate in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    if [[ -x "$_brew_candidate" ]]; then
        eval "$("$_brew_candidate" shellenv)"
        break
    fi
done
unset _brew_candidate

# Deduplicate PATH automatically (makes PATH handling faster)
typeset -U path

# Consolidate all PATH additions in one place for performance
# (brew bin dirs are added above via shellenv and preserved through $path)
path=(
    $DOTFILES/git/bin
    $TOOLS
    $HOME/.antidote
    $HOME/go/bin
    $HOME/.local/bin
    $HOME/.lmstudio/bin
    # $HOME/.claude/local/claude/bin
    $HOME/.antigravity/antigravity/bin
    $path
)

# Import alias (with file check)
[[ -f $DOTFILES/zsh/alias.zsh ]] && source $DOTFILES/zsh/alias.zsh

# Load all custom functions (history.zsh is sourced separately after plugins)
# Skip *.zwc artifacts: sourcing a compiled file by its .zwc path parses the
# wordcode binary as text. The base .zsh names transparently use their .zwc.
for func_file in $DOTFILES/zsh/functions/*; do
    [[ -f "$func_file" && "${func_file:e}" != "zwc" && "${func_file:t}" != "history.zsh" ]] && source "$func_file"
done

# Load custom theme (with file check)
[[ -f $DOTFILES/zsh/themes/my-theme/my-theme.zsh-theme ]] && source $DOTFILES/zsh/themes/my-theme/my-theme.zsh-theme

# go - cached brew prefix for performance
export GO111MODULE=on
# GOPRIVATE (private org globs) is set in zsh/local.zsh (gitignored).
export GOPATH=$HOME/go
# Derive GOROOT from the installed go toolchain (portable across macOS/Linux)
if [[ -z "${GOROOT:-}" ]] && command -v go >/dev/null 2>&1; then
    export GOROOT="$(go env GOROOT)"
fi

# mysql
export MYSQL_ENV_MYSQL_ROOT_USERNAME=root
export MYSQL_ENV_MYSQL_ROOT_PASSWORD=root

# Turn it all OFF
DO_NOT_TRACK=1

# AI integration (lazy loaded - only sources when file exists)
[[ -f $DOTFILES/zsh/ai.zsh ]] && source $DOTFILES/zsh/ai.zsh

# Machine/employer-specific overrides (gitignored). Holds private aliases,
# internal paths, GOPRIVATE orgs, and internal tool shims. See local.zsh.example.
[[ -f $DOTFILES/zsh/local.zsh ]] && source $DOTFILES/zsh/local.zsh

# Antidote - use static loading for performance (faster than dynamic)
# The .zsh_plugins.zsh file is pre-generated and just sources plugins directly
[[ -f ~/.zsh_plugins.zsh ]] && source ~/.zsh_plugins.zsh

# ↑/↓ filter history by what you've typed (e.g. "ssh " then ↑)
[[ -f $DOTFILES/zsh/functions/history.zsh ]] && source $DOTFILES/zsh/functions/history.zsh

# Completion menu - highlight selected item while navigating with arrow keys
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS} "ma=1;30;48;5;73"

# Tab: accept autosuggestion if one is showing, otherwise do normal completion
zle -N _tab_or_complete
bindkey '^I' _tab_or_complete


# NVM - lazy loaded for faster shell startup
# Homebrew installs nvm.sh under its prefix (NOT in ~/.nvm); git-clone/Linux
# installs put it in $NVM_DIR. Keep NVM_DIR set either way — Homebrew's nvm
# still uses it as the data dir. Prefer the brew copy, fall back to $NVM_DIR.
export NVM_DIR="$HOME/.nvm"
_nvm_lazy_load() {
    unset -f nvm node npm npx corepack 2>/dev/null
    local _nvm_prefix
    _nvm_prefix="$(brew --prefix nvm 2>/dev/null)"
    if [ -n "$_nvm_prefix" ] && [ -s "$_nvm_prefix/nvm.sh" ]; then
        \. "$_nvm_prefix/nvm.sh"
        [ -s "$_nvm_prefix/etc/bash_completion.d/nvm" ] && \. "$_nvm_prefix/etc/bash_completion.d/nvm"
    else
        [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
        [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
    fi
}
for cmd in nvm node npm npx corepack; do
    eval "${cmd}() { _nvm_lazy_load; ${cmd} \"\$@\" }"
done
unset cmd


# Added by Antigravity IDE
# Guarded so it no-ops on machines without the Antigravity IDE installed.
[[ -d "$HOME/.antigravity-ide/antigravity-ide/bin" ]] && export PATH="$HOME/.antigravity-ide/antigravity-ide/bin:$PATH"
